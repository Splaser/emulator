// Generated with actual production method bodies by run_registration_pipeline_tests.py.
// CPU/HostMemory/PageTable/tracker, cache state machine, native transfer and checked scheduler
// bodies are real. Vulkan dispatch/allocator, command execution and device mapping are fixtures.
#include <deque>
#include <limits>
#include <vulkan/vulkan.h>
#include "common/slot_vector.h"
