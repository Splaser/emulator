diff --git a/src/dynarmic/backend/arm64/address_space.cpp b/src/dynarmic/backend/arm64/address_space.cpp
--- a/src/dynarmic/backend/arm64/address_space.cpp
+++ b/src/dynarmic/backend/arm64/address_space.cpp
@@ -84,10 +84,27 @@ void AddressSpace::InvalidateBasicBlocks(const ankerl::unordered_dense::set<IR:
             continue;
         }
 
+        const CodePtr entry_point = iter->second;
+
         // Unlink before removal because InvalidateBasicBlocks can be called within a fastmem callback,
         // and the currently executing block may have references to itself which need to be unlinked.
         RelinkForDescriptor(descriptor, nullptr);
 
+        // Invalidated blocks are emitted at a new address if they are recompiled. Stop retaining their
+        // old entry points as sources for future relinks, otherwise frequently invalidated code makes
+        // block_references grow without bound and every subsequent relink scans all historical blocks.
+        if (const auto info_iter = block_infos.find(entry_point); info_iter != block_infos.end()) {
+            for (const auto& relocation : info_iter->second.block_relocations) {
+                const auto references_iter = block_references.find(relocation.first);
+                if (references_iter != block_references.end()) {
+                    references_iter->second.erase(entry_point);
+                    if (references_iter->second.empty()) {
+                        block_references.erase(references_iter);
+                    }
+                }
+            }
+        }
+
         block_entries.erase(iter);
     }
 
