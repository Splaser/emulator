diff --git a/src/dynarmic/common/tuple_hash.h b/src/dynarmic/common/tuple_hash.h
new file mode 100644
index 0000000..fdb4484
--- /dev/null
+++ b/src/dynarmic/common/tuple_hash.h
@@ -0,0 +1,27 @@
+// SPDX-FileCopyrightText: Copyright 2026 citron Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <tuple>
+#include <type_traits>
+
+namespace Dynarmic {
+
+// Explicit tuple hashing keeps the backend independent of host-project headers
+// and avoids specializing std::hash for standard-library-only tuple types.
+struct TupleHash {
+    template <typename... Ts>
+    std::size_t operator()(const std::tuple<Ts...>& key) const {
+        std::size_t seed = 0;
+        std::apply([&](const auto&... values) {
+            ((seed ^= std::hash<std::decay_t<decltype(values)>>{}(values) +
+                      0x9e3779b9 + (seed << 6) + (seed >> 2)), ...);
+        }, key);
+        return seed;
+    }
+};
+
+} // namespace Dynarmic
